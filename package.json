{
  "name": "penpot-vue-exporter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Export semantically marked Penpot shapes to Vue-oriented IR.",
  "scripts": {
    "dev": "tsx scripts/dev.mjs",
    "dev:ui": "vite --host 0.0.0.0 --port 4174",
    "build:ui": "vite build",
    "build:plugin": "VITE_BUILD_TARGET=plugin vite build",
    "build": "vue-tsc --noEmit && pnpm run build:ui && pnpm run build:plugin",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test \"generator/**/*.test.ts\" \"src/**/*.test.ts\"",
    "generate": "tsx generator/cli.ts",
    "package:plugin": "pnpm test && pnpm run build && node scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@penpot/plugin-styles": "^1.4.2",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@penpot/plugin-types": "^1.4.2",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  },
  "volta": {
    "node": "22.15.0",
    "pnpm": "9.15.9"
  }
}
